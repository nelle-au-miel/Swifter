{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current Swift File",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "New-Item -ItemType Directory -Force -Path \"${workspaceFolder}\\.build\" | Out-Null; swiftc \"${fileBasename}\" -o \"${workspaceFolder}\\.build\\swift-run.exe\" 2>$null; if ($LASTEXITCODE -eq 0) { & \"${workspaceFolder}\\.build\\swift-run.exe\" }",
            "presentation": {
                "reveal": "always",
                "echo": false,
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}