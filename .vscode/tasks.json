{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Swift: Compile",
            "type": "shell",
            "command": "swiftc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": [
                "$swiftc"
            ],
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            }
        }
    ]
}